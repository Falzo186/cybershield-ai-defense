.venv/
__pycache__/
*.pyc
data/*.db
data/*.txt
*.jsonl
.DS_Store
.env
.venv/.instalado
.claude/

# Resultados del prototipo (datos ficticios) que sí se publican
!data/redteam.db
!data/batallas.jsonl
!data/campana_a.txt
data/*.log

# Índice RAG: se reconstruye desde el corpus, no se versiona
data/rag_indice.json
# Campañas por lotes: el directorio es estado de ejecución y no se versiona, PERO las campañas grandes
# publicadas sí, porque son la evidencia primaria de las cifras de docs/CAMPANAS_GRANDES.md y
# docs/CAMPANA_ATACANTE.md. Sin ellas nadie puede rehacer la cuenta: los resúmenes en data/*.json son
# derivados. Son 1,4 MB de texto y datos ficticios de laboratorio.
data/campanas/*
!data/campanas/grande-*.jsonl
!data/campanas/atacante-*.jsonl
